# Copy to .env for local development:  cp .env.example .env
# NEVER commit the real .env file (it is in .gitignore).

PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/auditor.db
LOG_LEVEL=info
REPORT_RETENTION_DAYS=30
# Protects GET /api/metrics (send "Authorization: Bearer <token>")
METRICS_TOKEN=change-me

# Crawler limits
CRAWL_MAX_PAGES=10
CRAWL_MAX_DEPTH=2
CRAWL_CONCURRENCY=3
CRAWL_REQUEST_TIMEOUT_MS=10000
AUDIT_TIMEOUT_MS=90000
RATE_LIMIT_AUDITS_PER_HOUR=10
MAX_CONCURRENT_AUDITS=2
# Never "true" in production: allows auditing localhost/private networks.
ALLOW_PRIVATE_NETWORKS=false

# Optional: AI action plans (https://console.anthropic.com)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Optional: Lighthouse scores + Core Web Vitals (Google Cloud console, PageSpeed Insights API)
PAGESPEED_API_KEY=

# Optional: paid full reports (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_REPORT_PRICE_ID=
